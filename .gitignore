# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 107 MB Roblox export, baked into components/demos/a380-geometry.ts.
# Never commit: it would never reach Netlify and is four orders of magnitude
# too large to fetch in a browser. Re-bake with scratchpad/bake-a380.js.
public/*.obj
public/*.mtl

# Source browser icons: 1060 kB of PNGs, converted and squared into
# public/browsers/*.webp (55 kB total) by the AllOnWeb section. Untracked, so
# they would never reach Netlify anyway — this makes that explicit.
public/browser icons/

# Source archives for the A380, already baked into
# components/demos/a380-geometry.ts. 57 MB, referenced by nothing, and they
# were deploying to Netlify inside public/. Kept on disk, out of the repo.
public/*.zip
public/*.rar

# Source screenshots and screen recordings for the gallery, kept on disk and
# never deployed. The versions that ship are the WebP files in public/lookslike,
# converted from these — 6.33 MB of PNG became 0.93 MB. Committing the originals
# would breach the per-asset budget in scripts/check-budgets.mjs and put ~10 MB
# of duplicates on every clone, for files nothing references.
# Same treatment as the A380 archives above, and for the same reason.
public/v2 - Copy/
