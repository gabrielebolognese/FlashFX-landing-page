# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 107 MB Roblox export, baked into components/demos/a380-geometry.ts.
# Never commit: it would never reach Netlify and is four orders of magnitude
# too large to fetch in a browser. Re-bake with scratchpad/bake-a380.js.
public/*.obj
public/*.mtl

# Source browser icons: 1060 kB of PNGs, converted and squared into
# public/browsers/*.webp (55 kB total) by the AllOnWeb section. Untracked, so
# they would never reach Netlify anyway — this makes that explicit.
public/browser icons/
